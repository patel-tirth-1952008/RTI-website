# backend/.env.example

# ============================================
# RTI FILING SYSTEM - ENVIRONMENT VARIABLES
# ============================================
# ALL SERVICES USED ARE FREE TIER

# Application
APP_NAME="RTI Filing System"
APP_VERSION="1.0.0"
APP_ENV="production"
DEBUG=false
SECRET_KEY="your-super-secret-key-change-in-production-min-64-chars"
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Database (Free: Supabase PostgreSQL or local SQLite)
# Option 1: Supabase (Free - 500MB, unlimited API requests)
DATABASE_URL="postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
# Option 2: SQLite (Completely free, no signup)
# DATABASE_URL="sqlite+aiosqlite:///./rti_system.db"

# Redis (Free: Upstash - 10,000 commands/day free)
REDIS_URL="redis://default:[password]@[endpoint].upstash.io:6379"
# Or local Redis
# REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
JWT_SECRET_KEY="your-jwt-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI (Free: 60 requests/minute)
GOOGLE_GEMINI_API_KEY="your-gemini-api-key-from-aistudio.google.com"

# Email (Free: Gmail SMTP - 500 emails/day)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@rtisystem.com"

# File Storage (Free: Cloudinary - 25GB storage, 25GB bandwidth)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Geolocation
NOMINATIM_USER_AGENT="rti-filing-system-v1"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=100

# Encryption Key for PII data
ENCRYPTION_KEY="your-fernet-encryption-key-base64"

# Sentry (Free: 5,000 errors/month)
SENTRY_DSN="https://[key]@[org].ingest.sentry.io/[project]"

# RTI Portal Credentials (User provides their own)
# These are NOT stored here - they come per-request from the user